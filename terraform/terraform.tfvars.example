# -----------------------------------------------------------------------------
# Copy this file to terraform.tfvars and edit the values:
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is git-ignored. Never put passwords, tokens or AWS keys in it.
# -----------------------------------------------------------------------------

# Required: the AWS region to deploy into (ap-southeast-2 = Sydney).
# This account's AWS Organization only allows ap-southeast-2.
aws_region = "ap-southeast-2"

# Required: who may open the website. Find your public IP with:
#   curl -s https://checkip.amazonaws.com
# then add /32 to allow only that address.
allowed_http_cidrs = ["203.0.113.25/32"]

# Optional (defaults shown)
project_name        = "water-supply-tracker"
environment         = "dev"
owner               = "your-name"
instance_type       = "t3.small"
root_volume_size_gb = 20

# Pin images to an immutable tag or digest for repeatable deployments, e.g.
# frontend_image = "ghcr.io/shantheep7/water-supply-frontend@sha256:<digest>"
frontend_image = "ghcr.io/shantheep7/water-supply-frontend:latest"
backend_image  = "ghcr.io/shantheep7/water-supply-backend:latest"
