# Data source for the app:
#   local -> demo data stored in the browser's localStorage (default)
#   api   -> Spring Boot REST API
VITE_DATA_SOURCE=local

# Base URL of the Spring Boot REST API (used when VITE_DATA_SOURCE=api).
# "/api" works with the Vite dev proxy configured in vite.config.js.
VITE_API_BASE_URL=/api
